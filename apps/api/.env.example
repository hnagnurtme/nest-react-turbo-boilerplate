# Every variable in src/config/env.schema.ts must appear here.
# `pnpm check:env` fails the build when the two lists drift apart.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# The app connects as app_runtime: DML only, NOBYPASSRLS. Running the app as the
# owner role silently disables every tenant isolation policy.
DATABASE_URL=postgresql://app_runtime:app_runtime@localhost:5432/boilerplate
# Migrations only. Owner role, full DDL. Never used by the running process.
DATABASE_MIGRATION_URL=postgresql://app_owner:postgres@localhost:5432/boilerplate
DATABASE_POOL_MAX=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# At least 32 characters each, and the two MUST differ. `pnpm setup` generates them.
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Argon2id memory in KiB. 19456 = 19 MiB, the OWASP floor.
ARGON2_MEMORY_COST=19456

# --- CORS & cookies ----------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# The SPA origin, used for the CSRF Origin allowlist check on state changes.
WEB_ORIGIN=http://localhost:5173
# Required in production. Leave empty locally so the cookie stays host-only.
COOKIE_DOMAIN=
# lax when web and API share a site, none when they do not (doc 03 section 2.1).
COOKIE_SAMESITE=lax
# Must be true in production; false locally because http://localhost is not secure.
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token

# --- Observability -----------------------------------------------------------
OTEL_SERVICE_NAME=api
# Unset locally: without a collector the exporter just buffers and drops.
OTEL_EXPORTER_OTLP_ENDPOINT=
