{
  "name": "boilerplate",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "bootstrap": "tsx scripts/setup.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:seed": "pnpm --filter @repo/api db:seed",
    "db:studio": "pnpm --filter @repo/api db:studio",
    "api:contract": "pnpm --filter @repo/api generate:openapi && prettier --write packages/api-contract/openapi.json apps/api/openapi.json && pnpm --filter @repo/api-contract generate",
    "check:env": "tsx scripts/check-env-example.ts",
    "gen:module": "tsx scripts/gen-module.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^22.10.5",
    "@repo/tsconfig": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-39356",
        "CVE-2026-44902",
        "CVE-2026-59892"
      ]
    },
    "overrides": {
      "multer": "^2.3.0",
      "undici": "^6.27.0",
      "handlebars": "^4.7.9",
      "lodash": "^4.18.1",
      "js-yaml": "^4.3.2",
      "vite": "^6.4.3"
    }
  }
}
